node_modules/
dist/
data/
*.log
# Published OTA images are tracked so git history is the firmware changelog and
# the deploy transport (server serves them from FIRMWARE_DIR). Images are
# namespaced per board (firmware/<board>/); only the two published artifacts per
# board are tracked — any other scratch under firmware/ is not.
firmware/*
!firmware/*/
firmware/*/*
!firmware/*/image.bin
!firmware/*/manifest.txt

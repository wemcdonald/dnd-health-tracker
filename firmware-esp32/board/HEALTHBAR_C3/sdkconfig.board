# Rollback: a new OTA image boots "pending verify"; if the app never calls
# esp32.Partition.mark_app_valid_cancel_rollback(), the next reset reverts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Bluetooth is unused; dropping it frees space so the app fits one OTA slot.
# CONFIG_BT_ENABLED is not set
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
